; Управляется админ-панелью — вручную не править
[trunk]
type=endpoint
transport=transport-udp
context=incoming
disallow=all
allow=g722,alaw,ulaw
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
outbound_auth=trunk-auth
from_user=YOUR_SIP_LOGIN
from_domain=sip.novofon.ru
aors=trunk-aor

[trunk-auth]
type=auth
auth_type=digest
username=YOUR_SIP_LOGIN
password=YOUR_SIP_PASSWORD

[trunk-aor]
type=aor
contact=sip:sip.novofon.ru:5060

[trunk-reg]
type=registration
transport=transport-udp
outbound_auth=trunk-auth
server_uri=sip:sip.novofon.ru:5060
client_uri=sip:YOUR_SIP_LOGIN@sip.novofon.ru
retry_interval=60
forbidden_retry_interval=300
expiration=120


[trunk-identify]
type=identify
endpoint=trunk
match=37.139.38.0/24
